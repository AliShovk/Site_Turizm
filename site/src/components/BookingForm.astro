---
import { hotel, waUrl, bookingMode, bookingUrl, hasBookingForm } from '../lib/hotel';
const b = hotel.booking;
const mode = bookingMode();
const wa = waUrl(), email = hotel.contacts.email;
const show = hasBookingForm();
const label = { bnovo: 'Показать цены', link: 'Забронировать', request: 'Отправить заявку' }[mode];
const note = mode === 'request'
  ? `Заявка уйдёт администратору ${wa ? 'в WhatsApp' : 'на e-mail'} — он подтвердит наличие и цену.`
  : 'Откроется система бронирования отеля: актуальные цены, свободные номера и подтверждение сразу.';
---
{show && <div class="book wrap">
  <form id="book" method="post" data-mode={mode} data-url={b.url ?? ''} data-link={bookingUrl()} data-lang={b.lang ?? ''} data-wa={wa ?? ''} data-email={email ?? ''} data-hotel={hotel.name}>
    <div class="field"><label for="b-in">Заезд</label><input id="b-in" name="in" type="date" required></div>
    <div class="field"><label for="b-out">Выезд</label><input id="b-out" name="out" type="date" required></div>
    <div class="field">
      <label for="b-g">Гости</label>
      <select id="b-g" name="adults">
        <option value="1">1 взрослый</option>
        <option value="2" selected>2 взрослых</option>
        <option value="3">3 взрослых</option>
        <option value="4">4 взрослых</option>
      </select>
    </div>
    <button class="btn btn-navy" type="submit">{label}</button>
  </form>
  <p class="book-note">{note}</p>
</div>}
