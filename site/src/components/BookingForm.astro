---
import { hotel, waUrl } from '../lib/hotel';
const b = hotel.booking;
const mode = b.provider === 'bnovo' && b.url ? 'bnovo' : 'request';
---
<div class="book wrap">
  <form id="book" method="post" data-mode={mode} data-url={b.url ?? ''} data-lang={b.lang ?? ''} data-wa={waUrl() ?? ''} data-hotel={hotel.name}>
    <div class="field"><label for="b-in">Заезд</label><input id="b-in" name="in" type="date" required></div>
    <div class="field"><label for="b-out">Выезд</label><input id="b-out" name="out" type="date" required></div>
    <div class="field">
      <label for="b-g">Гости</label>
      <select id="b-g" name="adults">
        <option value="1">1 взрослый</option>
        <option value="2" selected>2 взрослых</option>
        <option value="3">3 взрослых</option>
        <option value="4">4 взрослых</option>
      </select>
    </div>
    <button class="btn btn-navy" type="submit">{mode === 'bnovo' ? 'Показать цены' : 'Отправить заявку'}</button>
  </form>
  <p class="book-note">{mode === 'bnovo'
    ? 'Откроется система бронирования отеля: актуальные цены, свободные номера и подтверждение сразу.'
    : 'Заявка уйдёт администратору в WhatsApp — он подтвердит наличие и цену.'}</p>
</div>
